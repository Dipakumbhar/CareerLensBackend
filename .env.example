# ─── CareerLens Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3000)
PORT=3000

# ─── Frontend URL (CORS) ───────────────────────────────────────────────────────
# URL of the frontend application (used for CORS allow-list)
# Development:  http://localhost:5173
# Production:   https://your-deployed-frontend.com
CLIENT_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (includes cluster host, username, and password)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# ─── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — use a long random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# ─── AI Service ────────────────────────────────────────────────────────────────
# Groq API key — obtain from https://console.groq.com/
GROQ_API_KEY=gsk_replace_with_your_groq_api_key

# ─── NODE_ENV ──────────────────────────────────────────────────────────────────
# Set to 'production' when deploying. Controls cookie security flags.
NODE_ENV=development
